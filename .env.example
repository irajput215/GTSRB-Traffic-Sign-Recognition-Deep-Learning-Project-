# Environment variables read by gtsrb.
#
# Copy to .env and edit. .env is git-ignored (see .gitignore); .env.example is
# not, so it stays a documentation of what can be configured.
#
# Precedence, lowest to highest:
#   schema defaults  ->  configs/*.yaml  ->  these variables  ->  key=value CLI overrides
#
# Nothing here is a secret. The MLflow tracking URI is the only variable that
# could carry a credential (for a remote tracking server); keep such a value in
# your shell or a secret manager, never in this file.

# --- Paths -----------------------------------------------------------------
# Where the GTSRB data lives. Relative paths resolve against the repo root.
# GTSRB_DATA_ROOT=data/raw

# Where checkpoints, evaluation reports and plots are written.
# GTSRB_OUTPUT_DIR=artifacts

# Checkpoint the inference API loads.
# GTSRB_CHECKPOINT_PATH=artifacts/checkpoints/best.pt

# --- Compute ---------------------------------------------------------------
# auto | cpu | cuda | mps
# GTSRB_DEVICE=auto

# --- Reproducibility -------------------------------------------------------
# GTSRB_SEED=43

# --- Experiment tracking ---------------------------------------------------
# A local SQLite database needs no server. Point this at an HTTP URI to use a
# remote MLflow instance; if that instance needs a token, export it in your shell,
# never here. (MLflow 3.x rejects the legacy file: store unless
# MLFLOW_ALLOW_FILE_STORE=true is set, which is why SQLite is the default.)
# GTSRB_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# GTSRB_MLFLOW_EXPERIMENT_NAME=gtsrb-traffic-sign-recognition

# --- Inference API ---------------------------------------------------------
# GTSRB_LOG_LEVEL=INFO
# GTSRB_API_HOST=0.0.0.0
# GTSRB_API_PORT=8000
# GTSRB_API_METRICS_ENABLED=true
